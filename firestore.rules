rules_version = '2';

// Regras de segurança do save na nuvem.
// Cada conta guarda as suas carreiras em users/{uid}/careers/{careerId}, e só o
// próprio dono lê e escreve. Publicar: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/careers/{careerId} {
      allow read, delete: if isOwner(userId);
      // O id é o que o jogo gera (newCareerId em src/core/storage.js): letras
      // minúsculas e números. O documento tem sempre os mesmos quatro campos, e
      // updatedAt é a hora do servidor (serverTimestamp).
      allow create, update: if isOwner(userId)
        && careerId.matches('^[a-z0-9]{8,32}$')
        && request.resource.data.keys().hasOnly(['meta', 'state', 'clientUpdatedAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['meta', 'state', 'clientUpdatedAt', 'updatedAt'])
        && request.resource.data.meta is map
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000
        && request.resource.data.clientUpdatedAt is number
        && request.resource.data.updatedAt == request.time;
    }

    // Formato antigo (uma carreira por conta). O jogo lê uma vez para migrar
    // para a lista nova e depois apaga.
    match /careers/{userId} {
      allow read, delete: if isOwner(userId);
    }

    // Nada mais é acessível pelo cliente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
