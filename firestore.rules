rules_version = '2';

// Regras de segurança do save na nuvem.
// Cada carreira fica em careers/{uid} e só o próprio dono lê e escreve.
service cloud.firestore {
  match /databases/{database}/documents {
    match /careers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Nada mais é acessível pelo cliente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
