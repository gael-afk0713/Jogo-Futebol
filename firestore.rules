rules_version = '2';

// Regras de segurança do save na nuvem.
// Cada conta guarda até 6 carreiras em users/{uid}/careers/{careerId}, e só o
// próprio dono lê e escreve.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/careers/{careerId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && careerId.size() <= 40
        && request.resource.data.keys().hasOnly(['meta', 'state', 'clientUpdatedAt', 'updatedAt'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000;
    }

    // Formato antigo (uma carreira por conta). O jogo lê uma vez para migrar
    // para a lista nova e depois apaga.
    match /careers/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Nada mais é acessível pelo cliente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
