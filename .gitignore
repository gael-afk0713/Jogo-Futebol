# Dependências (o jogo não precisa de nenhuma, mas servidores locais criam isso)
node_modules/
package-lock.json

# Sistema operacional / editores
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Build / cache de servidores estáticos
.cache/
dist/

# Capturas de revisão de design (regeráveis)
.impeccable/review/
.impeccable/config.local.json
# Playwright CLI output (may contain credentials)
.playwright-cli/
# Logs do emulador e da linha de comando do Firebase
firebase-debug.log
firestore-debug.log
ui-debug.log
# Capturas de tela dos testes no navegador (regeráveis)
tests/.saida/
